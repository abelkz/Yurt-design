{
 "functions": {
  "api/telegram.js": {
   "maxDuration": 60
  },
  "api/tg-setup.js": {
   "maxDuration": 20
  },
  "api/lead.js": {
   "maxDuration": 15
  },
  "api/proof.js": {
   "maxDuration": 30
  }
 },
 "rewrites": [
  {
   "source": "/p/:id",
   "destination": "/p/index.html"
  }
 ],
 "headers": [
  {
   "source": "/p/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/proekt/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ]
}